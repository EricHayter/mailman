# Settings for the deployment and scripts/chat.sh. Copy to .env and adjust:
#   cp .env.example .env
# Variables already set in your shell take precedence over .env.

# --- Deployment (deploy/light.yaml, deploy/full.yaml) ---

# Which deployment `docker compose` runs from the repo root:
#   deploy/light.yaml  tiny model, fast startup, for testing routing and
#                      health checks
#   deploy/full.yaml   a real model, for benchmarking
COMPOSE_FILE=deploy/light.yaml

# --- scripts/chat.sh ---

# Where to send requests. 127.0.0.1:3000 is mailman.
CHAT_ADDR=127.0.0.1:3000

# Model to request. Defaults to the model of the COMPOSE_FILE deployment,
# so leave this unset unless you're sending to something else.
# CHAT_MODEL=

# Keep this small; CPU vLLM is slow.
CHAT_MAX_TOKENS=64

# Uncomment to send straight to a vLLM node instead of mailman, with
# CHAT_ADDR set to the node (e.g. 127.0.0.1:8000).
# CHAT_PATH=/v1/chat/completions
