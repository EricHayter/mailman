# Settings for scripts/chat.sh. Copy to .env and adjust:
#   cp .env.example .env
# Variables already set in your shell take precedence over .env.

# Where to send requests. 127.0.0.1:3000 is mailman.
CHAT_ADDR=127.0.0.1:3000

# The model served by the vLLM nodes in deploy/compose.yaml.
CHAT_MODEL=Qwen/Qwen3-0.6B

# Keep this small; CPU vLLM is slow.
CHAT_MAX_TOKENS=64

# Uncomment to send straight to a vLLM node instead of mailman, with
# CHAT_ADDR set to the node (e.g. 127.0.0.1:8000).
# CHAT_PATH=/v1/chat/completions
